- content_for :page_title do
  = t('admin.settings.appearance.title')

- content_for :heading do
  %h1= t('admin.settings.title')
  = render partial: 'admin/settings/shared/links'

= simple_form_for @admin_settings, url: admin_settings_appearance_path do |f|
  = render 'shared/error_messages', object: @admin_settings

  %p.lead= t('admin.settings.appearance.preamble')

  .fields-group
    = f.input :theme,
              collection: Themes.instance.names,
              include_blank: false,
              label_method: ->(theme) { I18n.t("themes.#{theme}", default: theme) },
              wrapper: :with_label

  .fields-group
    = f.input :custom_css,
              as: :text,
              input_html: { rows: 8 },
              wrapper: :with_block_label

  .fields-row
    .fields-row__column.fields-row__column-6.fields-group
      = f.input :mascot,
                as: :file,
                wrapper: :with_block_label

    .fields-row__column.fields-row__column-6.fields-group
      - if @admin_settings.mascot.persisted?
        = image_tag @admin_settings.mascot.file.url, class: 'fields-group__thumbnail'
        = link_to admin_site_upload_path(@admin_settings.mascot), data: { method: :delete }, class: 'link-button link-button--destructive' do
          = material_symbol 'delete'
          = t('admin.site_uploads.delete')

  %hr.spacer/

  %h4= t('admin.settings.appearance.branding_uploads')
  %p.lead= t('admin.settings.appearance.branding_uploads_hint')
  %p.lead= t('admin.settings.appearance.branding_uploads_hint_blank')
  %p.lead= t('admin.settings.appearance.branding_uploads_hint_theme')

  -# Only the section for the currently-selected theme (above) is shown; the
  -# inline script below toggles them. Both stay in the DOM so every field still
  -# submits.
  - Themes.instance.names.each do |theme_name|
    - token = theme_name == 'bird-ui' ? 'birdui' : 'default'
    .brand-theme-section{ data: { brand_theme: theme_name } }
      %hr.spacer/
      %h5= t("admin.settings.appearance.brand_theme_#{token}")
      - %w(logo login_bg app_bg).each do |asset|
        - %w(light dark).each do |scheme|
          - key = "#{asset}_#{token}_#{scheme}"
          .fields-row
            .fields-row__column.fields-row__column-6.fields-group
              = f.input key.to_sym,
                        as: :file,
                        label: t("admin.settings.appearance.#{asset}_#{scheme}"),
                        wrapper: :with_block_label
            .fields-row__column.fields-row__column-6.fields-group
              - upload = @admin_settings.public_send(key)
              - if upload.persisted?
                = image_tag upload.file.url, class: 'fields-group__thumbnail'
                = link_to admin_site_upload_path(upload), data: { method: :delete }, class: 'link-button link-button--destructive' do
                  = material_symbol 'delete'
                  = t('admin.site_uploads.delete')

      -# momodo: brand colors for this theme — same light/dark split as the
      -# uploads above. Blank keeps the theme's own color.
      %h6.momodo-color-heading= t('admin.settings.appearance.brand_colors')
      %p.lead= t('admin.settings.appearance.brand_colors_hint')
      - %w(light dark).each do |scheme|
        %p.momodo-color-scheme-label= t("admin.settings.appearance.brand_scheme_#{scheme}")
        - Form::AdminSettings::BRAND_COLOR_SLOTS.each do |slot|
          - key = "color_#{slot}_#{token}_#{scheme}"
          - value = @admin_settings.public_send(key).presence
          - fallback = Form::AdminSettings::BRAND_COLOR_DEFAULTS[token][slot]
          .fields-row
            .fields-row__column.fields-row__column-6.fields-group
              = f.input key.to_sym,
                        as: :string,
                        label: t("admin.settings.appearance.brand_color_#{slot}"),
                        hint: t("admin.settings.appearance.brand_color_#{slot}_hint"),
                        wrapper: :with_block_label,
                        input_html: { placeholder: fallback, maxlength: 7, class: 'momodo-color-text', data: { color_key: key } }
            .fields-row__column.fields-row__column-6.fields-group
              %label.momodo-color-swatch
                %input{ type: 'color', value: (value || fallback), data: { color_swatch_for: key }, aria: { label: t("admin.settings.appearance.brand_color_#{slot}") } }
                %span.momodo-color-swatch__clear{ data: { color_clear_for: key } }= t('admin.settings.appearance.brand_color_clear')

  -# Show only the selected theme's upload slots, and switch live when the theme
  -# dropdown changes. Nonce required or CSP blocks the inline script.
  - brand_switch_js = "(function(){var s=document.querySelector('select[name$=\"[theme]\"]');var b=document.querySelectorAll('.brand-theme-section');if(!s||!b.length){return;}function u(){for(var i=0;i<b.length;i++){b[i].style.display=(b[i].getAttribute('data-brand-theme')===s.value)?'':'none';}}s.addEventListener('change',u);u();})();"
  = content_tag :script, brand_switch_js.html_safe, nonce: request.content_security_policy_nonce

  -# Keep the color picker and its hex field in sync, and let "기본값" clear the
  -# slot (an <input type=color> can never be empty, so the text field is the
  -# source of truth and blank = use the theme's own color).
  - color_sync_js = "(function(){var t=document.querySelectorAll('.momodo-color-text');for(var i=0;i<t.length;i++){(function(f){var k=f.getAttribute('data-color-key');var sw=document.querySelector('[data-color-swatch-for=\"'+k+'\"]');var cl=document.querySelector('[data-color-clear-for=\"'+k+'\"]');if(!sw){return;}f.addEventListener('input',function(){if(/^#[0-9a-fA-F]{6}$/.test(f.value)){sw.value=f.value;}});sw.addEventListener('input',function(){f.value=sw.value;});if(cl){cl.addEventListener('click',function(e){e.preventDefault();f.value='';});}})(t[i]);}})();"
  = content_tag :script, color_sync_js.html_safe, nonce: request.content_security_policy_nonce

  .actions
    = f.button :button, t('generic.save_changes'), type: :submit
